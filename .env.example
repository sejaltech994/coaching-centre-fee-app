# Copy to .env for local development: cp .env.example .env
# Never commit .env. Deployed environments keep these in their host's secret store.

# --- API (apps/api) ---
NODE_ENV=development
PORT=8787
# Embedded Postgres saved in ./.data, no install needed. For a real server use
# postgres://user:password@host:5432/dbname (e.g. a Neon branch).
DATABASE_URL=pglite:../../.data/dev
# At least 32 random characters. Generate one: openssl rand -base64 48
JWT_SECRET=
# Web app origins allowed to call the API with cookies, comma-separated.
WEB_ORIGINS=http://localhost:3000
# Only "true" behind a trusted proxy (e.g. Cloudflare) that sets the client IP headers.
TRUST_PROXY_HEADERS=false
# Each centre connects its OWN Razorpay account in Settings (keys stored encrypted
# with a key derived from JWT_SECRET). "fake" gives a test checkout instead
# (development and tests only; refused in production).
RAZORPAY_PROVIDER=fake
# WhatsApp reminders from Chukta's number. "fake" logs them instead (not in
# production). For Meta's Cloud API set WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID,
# WHATSAPP_APP_SECRET and WHATSAPP_VERIFY_TOKEN. Unset: reminders are skipped.
WHATSAPP_PROVIDER=fake

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8787/api/v1

# --- Later features ---
REDIS_URL=redis://localhost:6379
SMS_API_KEY=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
