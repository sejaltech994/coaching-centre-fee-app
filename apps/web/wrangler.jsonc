// Cloudflare Workers config: one Worker per environment serves the static web
// app AND the API (apps/api/src/worker.ts answers /api/*; everything else is
// a static file). Same origin, so the refresh cookie stays first-party.
// Deployed by .github/workflows/deploy.yml:
//   wrangler deploy --env dev   -> chukta-web-dev   (develop)
//   wrangler deploy --env sit   -> chukta-web-sit   (sit)
//   wrangler deploy --env uat   -> chukta-web-uat   (uat)
//   wrangler deploy --env prod  -> chukta-web-prod  (main)
// Secrets (never here): DATABASE_URL and JWT_SECRET, pushed by the deploy
// workflow from the GitHub environment's secrets. The API connects through the
// env's Hyperdrive binding when it has one (IDs aren't secrets). See docs/deployment.md.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "chukta-web",
  // Not a secret (it appears in every dashboard URL); the API token is.
  "account_id": "331f26e5ac81748f2fa5699192fabc53",
  "main": "../api/src/worker.ts",
  "compatibility_date": "2026-10-01",
  // node:crypto for token hashing; pg's TCP sockets to Neon.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only API requests run the Worker script; static files are served directly.
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": true,
  "preview_urls": false,
  // vars and observability are not inherited by environments, so each lists its own.
  "env": {
    "dev": {
      // Run next to the database (Neon, AWS us-east-2): each query is ~2 ms
      // instead of ~220 ms from the visitor's nearest edge.
      "placement": { "mode": "targeted", "region": "aws:us-east-2" },
      // Pooled, warm connections (no TCP + TLS + login per request). Query cache is
      // off on the Hyperdrive config: writes don't invalidate it, so lists would go stale.
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "2d1e1b85b776482087adb790ff4a8990" }],
      // Hourly scheduled jobs (bills, overdue, reminders): the Worker's scheduled().
      // The free plan allows 5 Cron Triggers per account; the 4 environments use 4.
      "triggers": { "crons": ["0 * * * *"] },
      // Workers Logs: console output kept in the dashboard.
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } },
      "vars": {
        "NODE_ENV": "staging",
        "TRUST_PROXY_HEADERS": "true",
        "WEB_ORIGINS": "https://chukta-web-dev.chukta.workers.dev"
      }
    },
    "sit": {
      // Run next to the database (Neon, AWS us-east-2): each query is ~2 ms
      // instead of ~220 ms from the visitor's nearest edge.
      "placement": { "mode": "targeted", "region": "aws:us-east-2" },
      // Pooled, warm connections (no TCP + TLS + login per request). Query cache is
      // off on the Hyperdrive config: writes don't invalidate it, so lists would go stale.
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "acfacac4058841f0a8f436ec6db153e7" }],
      // Hourly scheduled jobs (bills, overdue, reminders): the Worker's scheduled().
      // The free plan allows 5 Cron Triggers per account; the 4 environments use 4.
      "triggers": { "crons": ["0 * * * *"] },
      // Workers Logs: console output kept in the dashboard.
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } },
      "vars": {
        "NODE_ENV": "staging",
        "TRUST_PROXY_HEADERS": "true",
        "WEB_ORIGINS": "https://chukta-web-sit.chukta.workers.dev"
      }
    },
    "uat": {
      // Run next to the database (Neon, AWS us-east-2): each query is ~2 ms
      // instead of ~220 ms from the visitor's nearest edge.
      "placement": { "mode": "targeted", "region": "aws:us-east-2" },
      // Pooled, warm connections (no TCP + TLS + login per request). Query cache is
      // off on the Hyperdrive config: writes don't invalidate it, so lists would go stale.
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "c3cb8c0275d74bf0929c2af27b879869" }],
      // Hourly scheduled jobs (bills, overdue, reminders): the Worker's scheduled().
      // The free plan allows 5 Cron Triggers per account; the 4 environments use 4.
      "triggers": { "crons": ["0 * * * *"] },
      // Workers Logs: console output kept in the dashboard.
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } },
      "vars": {
        "NODE_ENV": "staging",
        "TRUST_PROXY_HEADERS": "true",
        "WEB_ORIGINS": "https://chukta-web-uat.chukta.workers.dev"
      }
    },
    "prod": {
      // Hourly scheduled jobs (bills, overdue, reminders): the Worker's scheduled().
      // The free plan allows 5 Cron Triggers per account; the 4 environments use 4.
      "triggers": { "crons": ["0 * * * *"] },
      // Workers Logs: console output kept in the dashboard.
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } },
      "vars": {
        "NODE_ENV": "production",
        "TRUST_PROXY_HEADERS": "true",
        "WEB_ORIGINS": "https://chukta-web-prod.chukta.workers.dev"
      }
    }
  }
}
